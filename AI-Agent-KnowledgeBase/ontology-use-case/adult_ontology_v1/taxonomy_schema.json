{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ontology/taxonomy-v1.1.schema.json",
  "type": "object",
  "required": [
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "parent_id",
          "axis",
          "level",
          "category_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "axis": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "category_id": {
            "enum": [
              null,
              "BODY",
              "ACT",
              "KINK",
              "FORMAT",
              "PRODUCT",
              "SOCIAL",
              "IDENTITY",
              "COMMERCE"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "level": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "parent_id": {
                  "type": "null"
                },
                "category_id": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "category_id": {
                  "enum": [
                    "BODY",
                    "ACT",
                    "KINK",
                    "FORMAT",
                    "PRODUCT",
                    "SOCIAL",
                    "IDENTITY",
                    "COMMERCE"
                  ]
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "predicate",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "predicate": {
            "enum": [
              "IS_A",
              "ALIAS_OF",
              "RELATED_TO",
              "CO_OCCURS_WITH",
              "USES_PRODUCT",
              "HAS_FORMAT"
            ]
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
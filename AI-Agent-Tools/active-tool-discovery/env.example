# Copy this file to .env and fill in your key.
# This experiment uses OpenAI by default for both chat and embeddings.
# Without a key, run: python demo.py --offline (local embeddings + mock model).
OPENAI_API_KEY=your-openai-api-key

# Fallback: if OPENAI_API_KEY is absent but OPENROUTER_API_KEY is set, chat
# automatically uses OpenRouter (with model names such as openai/gpt-5.6-luna).
# Because OpenRouter has no embeddings API, retrieval uses local hash embeddings.
# OPENROUTER_API_KEY=your-openrouter-api-key

# Optional chat model; defaults to gpt-5.6-luna.
# MODEL=gpt-5.6-luna

# Optional embedding model; defaults to text-embedding-3-small (direct OpenAI only).
# EMBED_MODEL=text-embedding-3-small

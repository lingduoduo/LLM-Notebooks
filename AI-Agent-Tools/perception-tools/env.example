# Official OpenAI API for hosted image/video analysis and audio fallback.
OPENAI_API_KEY=your_openai_api_key_here
PERCEPTION_VISION_MODEL=gpt-5.6-luna

# Optional Google Custom Search credentials. DuckDuckGo is the fallback.
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Optional Notion integration.
# NOTION_API_KEY=your_notion_api_key_here

# Google Calendar uses OAuth credentials created by the Google client flow.

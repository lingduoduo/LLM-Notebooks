# OpenAI configuration
# Copy this file to .env and fill in your key. Every entry point in this project
# (agent.py, server.py, event_loop_demo.py, quickstart.py, ...) loads .env
# automatically; real environment variables always take precedence.

# Required: your OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: model override (default: gpt-5.2)
# Must be a model that supports function tools on /v1/chat/completions --
# e.g. gpt-5.2, gpt-5.1, gpt-5, gpt-4.1. The gpt-5.6-* models do NOT: they
# reject function tools there unless reasoning is disabled, and this agent
# drives every action through tools.
# OPENAI_MODEL=gpt-5.2

# Optional: point at an OpenAI-compatible endpoint (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: custom server port (default: 8000)
# AGENT_PORT=8000

# Optional: set to false to skip MCP tool loading and use built-in tools only
# ENABLE_MCP_TOOLS=true

# Note on model parameters: the GPT-5 family and the o-series are reasoning
# models. They only accept temperature=1 and take max_completion_tokens instead
# of max_tokens; agent.py detects this and adjusts each request automatically.

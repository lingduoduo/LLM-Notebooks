# ============================================================
# Supplementary case: Alita-style tool self-expansion - example environment variables
# Copy to .env or export the variables directly
# ============================================================

# Defaults to OpenAI (gpt-5.6-luna) with function calling
OPENAI_API_KEY=your-openai-api-key

# Fallback: if the provider key is missing but OPENROUTER_API_KEY is set,
# automatically use OpenRouter and map model names to openai/gpt-5.6-luna, etc.
# OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: choose one of three OpenAI-compatible providers and override the model
# LLM_PROVIDER=openai        # openai | moonshot | ark
# LLM_MODEL=gpt-5.6-luna     # Override the default model
# MOONSHOT_API_KEY=your-moonshot-api-key    # When LLM_PROVIDER=moonshot
# ARK_API_KEY=...            # When LLM_PROVIDER=ark

# Note: web_search uses DuckDuckGo and requires no search API key.

# Copy this file to .env, or export the values directly. TTS synthesis and
# Whisper transcription must use OpenAI directly, so they require this key.
# The default LLM rubric judge is gpt-5.6-luna.
OPENAI_API_KEY=sk-your-openai-key

# Optional: OpenRouter fallback for LLM rubric evaluation. Only rubric chat
# calls can use this fallback; TTS and Whisper cannot.
# Direct OpenAI access to gpt-5.x may require organization verification. When
# this key is set, rubric evaluation prefers OpenRouter.
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Optional: required only when `python demo.py --gemini` uses Gemini
# multimodal audio evaluation. The default Gemini model is gemini-3.5-flash.
# Without --gemini, evaluation uses Whisper transcription plus the
# gpt-5.6-luna rubric and does not need this key.
# GEMINI_API_KEY=your-gemini-key

# Optional: configure these as needed for cross-provider comparisons with
# `--providers openai,elevenlabs,minimax,...`. An unconfigured provider marks
# only its row as failed; see `python demo.py --list-providers` for details.
# ELEVENLABS_API_KEY=your-elevenlabs-key
# FISH_API_KEY=your-fishaudio-key            # FISHAUDIO_API_KEY is also accepted.
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_GROUP_ID=your-minimax-group-id
# DOUBAO_APP_ID=your-volcengine-app-id
# DOUBAO_ACCESS_TOKEN=your-volcengine-access-token

# Copy this file to .env or export the variables directly. The default model is gpt-5.6-luna.
#
# Credential precedence (see config.make_client_and_model):
#   1. If OPENROUTER_API_KEY is set and the model starts with "gpt-5", OpenRouter wins.
#   2. Otherwise OPENAI_API_KEY is used against the OpenAI endpoint.
#   3. Otherwise OPENROUTER_API_KEY is used against the OpenAI-compatible endpoint.
#   4. With neither key set, live mode exits; use --offline, which needs no credentials.
OPENAI_API_KEY=sk-your-openai-key

# OpenRouter fallback key (gpt-* maps to openai/*, claude-* maps to anthropic/*)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Optional: override the default model (gpt-5.6-luna).
# --model overrides this for a single run and also selects the price preset;
# presets are gpt-4o-mini, gpt-4o, gpt-4.1-mini, and gpt-4.1.
# COST_DEMO_MODEL=gpt-5.6-luna

# Copy this file to .env or export the variables directly. The default model is gpt-5.6-luna.
# OPENAI_API_KEY is preferred; when absent, OPENROUTER_API_KEY uses the OpenAI-compatible endpoint.
# Note: if OPENROUTER_API_KEY is set for a gpt-5.x model, the OpenRouter route is preferred.
OPENAI_API_KEY=sk-your-openai-key

# OpenRouter fallback key (used without OPENAI_API_KEY; gpt-* maps to openai/*)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Optional: override the default model (gpt-5.6-luna)
# COST_DEMO_MODEL=gpt-5.6-luna

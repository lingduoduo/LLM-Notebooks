# Copy to .env and fill in the keys you actually have.
# Only set keys for providers you plan to run; missing ones will fail-fast at request time.
# Keys are read via --key-env and passed to the adapter; nothing else.

# Jev / TypeSafe  (https://docs.typesafe.ai/)
TYPESAFE_API_KEY=

# OpenAI  (https://platform.openai.com/api-keys) — all verbalized models
OPENAI_API_KEY=
# Optional: Azure / proxy / compatible gateway
# OPENAI_API_KEY_BASE_URL=https://api.openai.com/v1

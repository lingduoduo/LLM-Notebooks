# Copy to .env and fill in your OpenAI API key.
OPENAI_API_KEY=your-openai-api-key-here

# Direct OpenAI endpoint (used by the demo, comparison runner, and judge).
# The official experiment runner always uses this endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI model; --model overrides this value.
OPENAI_MODEL=gpt-5.6-luna

# Required for real web search in research tasks and official experiments.
TAVILY_API_KEY=your-tavily-key
